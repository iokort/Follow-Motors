{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "followmotors": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/followmotors",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "assets": []
          },
          "configurations": {
            "production": { "outputHashing": "all", "budgets": [
              { "type": "initial", "maximumWarning": "900kB", "maximumError": "2MB" }
            ] },
            "development": { "optimization": false, "sourceMap": true, "extractLicenses": false }
          },
          "defaultConfiguration": "development"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "followmotors:build:production" },
            "development": { "buildTarget": "followmotors:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
