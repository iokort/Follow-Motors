        decimal costo_unitario_proveedor
        varchar referencia_factura_proveedor
        datetime solicitada_en
        datetime recibida_en
        datetime devuelta_en
    }
    ordenes_servicio {
        bigint id PK
        bigint presupuesto_id FK
        enum estado
        datetime iniciada_en
        datetime aviso_avance_25_en
        datetime terminada_en
        datetime entregada_en
        int version
        datetime creada_en
    }
    anticipos_reparacion {
        bigint id PK
        bigint orden_id FK
        decimal monto_mano_obra
        decimal monto_refacciones
        decimal total_pagado
        varchar referencia_comprobante
        bigint registrado_por_usuario_id FK
        datetime pagado_en
    }
    garantias_servicio {
        bigint id PK
        bigint orden_id FK
        boolean aplica
        smallint duracion_dias
        text condiciones
        datetime informada_en
        datetime inicia_en
        datetime vence_en
        varchar referencia_comprobante
    }
    solicitudes_cancelacion {
        bigint id PK
        bigint orden_id FK
        bigint cliente_id FK
        enum estado
        decimal progreso_al_resolver
        decimal costo_mano_obra_realizada
        decimal costo_refacciones_usadas
        decimal monto_reembolsado
        varchar motivo_rechazo
        datetime solicitada_en
        datetime resuelta_en
        datetime reembolsada_en
    }
    mantenimientos_programados {
        bigint id PK
        bigint motocicleta_id FK
        bigint orden_origen_id FK
        varchar descripcion
        date fecha_estimada
        int kilometraje_objetivo
        enum estado
    }
    notificaciones {
        bigint id PK
        bigint cliente_id FK
        bigint orden_id FK
        bigint cita_id FK
        enum tipo
        varchar mensaje
        datetime creada_en
        datetime leida_en
    }
    auditoria {
        bigint id PK
        bigint usuario_id FK
        varchar entidad
        bigint registro_id
        varchar accion
        json antes
        json despues
        datetime registrada_en
    }
