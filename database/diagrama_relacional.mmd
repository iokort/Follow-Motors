        datetime entrega_estimada
        enum estado
        bigint registrado_por_usuario_id FK
        datetime acordado_en
        datetime creado_en
    }
    tareas_servicio {
        bigint id PK
        bigint presupuesto_id FK
        varchar descripcion
        smallint orden
        decimal peso_porcentual
        decimal avance_tarea
        enum estado
        text evidencia
        datetime actualizada_en
    }
    refacciones_servicio {
        bigint id PK
        bigint presupuesto_id FK
        varchar descripcion
        smallint cantidad_solicitada
        smallint cantidad_recibida
        smallint cantidad_utilizada
        smallint cantidad_devuelta
