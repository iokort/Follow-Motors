erDiagram
    usuarios {
        bigint id PK
        varchar identificador
        varchar hash_contrasena
        enum rol
        boolean activo
        datetime creado_en
        datetime actualizado_en
    }
    clientes {
        bigint id PK
        bigint usuario_id FK
        varchar nombres
        varchar apellidos
        varchar telefono
        bigint registrado_por_usuario_id FK
        datetime creado_en
    }
    empleados {
        bigint id PK
        bigint usuario_id FK
        varchar nombres
        varchar apellidos
        boolean es_mecanico
        boolean disponible
    }
    motocicletas {
        bigint id PK
        bigint cliente_id FK
        varchar numero_serie
        varchar placa
        varchar marca
        varchar modelo
        smallint anio
        varchar color
        int kilometraje_actual
        datetime registrada_en
    }
    franjas_citas {
        bigint id PK
        datetime inicio
        datetime fin
        smallint capacidad
        boolean habilitada
        bigint creada_por_usuario_id FK
    }
    citas {
        bigint id PK
        bigint franja_id FK
        bigint cliente_id FK
        bigint motocicleta_id FK
        varchar motivo
        enum origen
        enum estado
        datetime registrada_en
    }
    tarifas_revision {
        bigint id PK
        decimal importe
        datetime vigente_desde
        datetime vigente_hasta
    }
    atenciones {
        bigint id PK
        bigint cliente_id FK
        bigint motocicleta_id FK
        bigint cita_id FK
        bigint mecanico_id FK
        text motivo
        int kilometraje_ingreso
        text diagnostico
        enum estado
        datetime ingresada_en
        datetime diagnosticada_en
    }
    cobros_revision {
        bigint id PK
        bigint atencion_id FK
        bigint tarifa_id FK
        decimal importe_cobrado
        bigint registrado_por_usuario_id FK
        datetime cobrado_en
        varchar referencia_comprobante
    }
    tipos_servicio {
        bigint id PK
        varchar nombre
        text descripcion
        smallint garantia_dias
        text cobertura
        boolean activo
    }
    presupuestos {
        bigint id PK
        bigint atencion_id FK
        bigint tipo_servicio_id FK
        text descripcion_trabajo
        decimal mano_obra_acordada
